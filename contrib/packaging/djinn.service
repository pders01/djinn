[Unit]
Description=djinn drop-down terminal (GTK4/VTE)
Documentation=https://github.com/pders01/djinn

# Wait for the graphical session to be up before launching — djinn
# needs WAYLAND_DISPLAY / DBUS_SESSION_BUS_ADDRESS / XDG_RUNTIME_DIR
# and the portal backends to exist before it can register the
# GlobalShortcuts hotkey and StatusNotifierItem. `graphical-session`
# is the cross-compositor target (KDE / GNOME / sway via plasma-
# workspace.service / gnome-session-x11.target / sway-session.target
# all populate it). Hyprland and bare sway/wlroots compositors that
# don't run through `uwsm`, `niri-session`, or a similar session
# manager must arrange their graphical session environment themselves.
# This unit is optional: no package enables or starts it automatically.
# See share/doc/djinn/packaging.md for opt-in launch instructions.
After=graphical-session.target
PartOf=graphical-session.target

# Explicitly cap respawn at 5 restarts per 30s rather than relying on
# the user manager's defaults. A crash loop or missing native library
# must not restart every 2s indefinitely and flood the journal.
# StartLimitBurst trips a transient failure state after the cap;
# `systemctl --user reset-failed djinn` clears it.
StartLimitBurst=5
StartLimitIntervalSec=30s

[Service]
Type=simple

# Hardcoded to /usr/bin/djinn — matches the canonical install path
# the Arch / Debian packages use (`--prefix /usr`). Nix substitutes
# its output path at packaging time. Manual installs to /usr/local
# should drop their own
# copy of this file into /usr/local/lib/systemd/user/ with the
# ExecStart adjusted.
ExecStart=/usr/bin/djinn

# Restart on crash, not on clean exit. Quitting via the tray menu or
# closing the panel should NOT respawn the process — that's a user
# decision to stop. `on-failure` covers SIGSEGV / panic / nonzero
# exit only.
Restart=on-failure
RestartSec=2s

# main_linux.zig wires a SIGTERM handler via g_unix_signal_add that
# calls panel.quit() for a clean GLib loop teardown. `systemctl
# --user stop djinn` requests the same GLib teardown as closing the
# window. The stop timeout can still terminate slow/stuck descendants.
KillSignal=SIGTERM
TimeoutStopSec=5s

# This is a terminal, not an isolated daemon: execution restrictions are
# inherited by PTY children, not just the Zig parent. NoNewPrivileges
# would prevent sudo/setuid elevation; MemoryDenyWriteExecute would break
# JIT programs. Filesystem, namespace, capability, and other syscall
# restrictions can likewise change legitimate shell commands. This unit
# adds none of them. User/system-wide policies still apply; confinement
# of an individual workload belongs in that workload's explicit launcher.

[Install]
WantedBy=graphical-session.target
