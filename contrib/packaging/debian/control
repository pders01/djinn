# Builders must supply exactly Zig 0.17.1 before dpkg-buildpackage.
# This local packaging recipe does not assume the distribution archive
# carries that compiler. debian/rules validates $(ZIG); override with
# ZIG=/opt/zig-0.17.1/zig if necessary. Ubuntu 24.04 also needs a local
# libgtk4-layer-shell-dev package (or use the CI source-build recipe).

Package: djinn
Architecture: any
Depends:
 ${shlibs:Depends},
 ${misc:Depends},
 libgtk-4-1,
 libgtk4-layer-shell-0,
 libvte-2.91-gtk4-0,
 xdg-desktop-portal,
Recommends:
 xdg-desktop-portal-kde | xdg-desktop-portal-hyprland | xdg-desktop-portal-wlr,
Suggests:
 socat,
Description: Quake-style drop-down terminal (GTK4/VTE, Wayland)
 djinn uses GTK4 and VTE with optional layer-shell positioning on
 compatible Wayland compositors. It reads Ghostty-compatible terminal
 configuration and themes; it does not link libghostty on Linux.
 GlobalShortcuts uses xdg-desktop-portal, with a Unix socket bridge
 for compositor hotkey bindings. Desktop launch and the systemd user
 unit are optional; the package does not enable autostart.
