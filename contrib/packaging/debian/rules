#!/usr/bin/make -f
# debhelper rules for djinn. Drives the zig build via the standard dh
# stages; overrides are minimal because zig already does build +
# install with a single --prefix-aware invocation.

# ZIG is overridable for hosts where zig isn't on PATH or a specific
# version is needed. Defaults to the user's `zig` binary; CI / packagers
# can pass ZIG=/opt/zig-0.17.1/zig.
export ZIG ?= zig

# Defaults work for djinn: `dh $@` runs the full sequence including
# dh_strip (debug info → -dbgsym sub-package) and dh_makeshlibs +
# dh_shlibdeps (populates ${shlibs:Depends} in control). The zig
# binary is ELF + dynamically linked to GTK/VTE/glib so the standard
# Debian helpers DO produce useful output here — earlier comments
# claiming "skip these" were aspirational and never actually wired
# (no override_dh_strip stanza existed), which left the comment
# divergent from behavior. Removing the claim keeps comment and rules
# in sync.

%:
	dh $@

override_dh_auto_configure:
	test "$$($(ZIG) version)" = 0.17.1
	# Cold caches require network access; this targets local builds,
	# not official offline Debian buildds. No Darwin patch on Linux.
	$(ZIG) build --fetch

override_dh_auto_build:
	$(ZIG) build -Doptimize=ReleaseSafe -Dsystem-install=true

override_dh_auto_install:
	# Stage the install tree under debian/tmp/usr — dh_install then
	# picks it up via debian/djinn.install. Routing through debian/tmp
	# instead of hardcoding debian/djinn keeps the rules file
	# agnostic about the binary package name, so a future split out
	# of -doc / -dbgsym sub-packages doesn't need a rules edit.
	# `-Dsystem-install=true` is what tells build.zig to drop
	# .desktop / .service / LICENSE / README alongside the binary;
	# without it dh_install would find only usr/bin/djinn and miss
	# the rest.
	$(ZIG) build install -Doptimize=ReleaseSafe -Dsystem-install=true \
	    --prefix debian/tmp/usr

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(ZIG) build check test
endif

# Shipping a launch option is not consent to start a persistent process.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable --no-start
